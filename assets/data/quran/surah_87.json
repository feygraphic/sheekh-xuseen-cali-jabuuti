{
  "surah_number": 87,
  "ayahs_count": 19,
  "ayahs": [
    {
      "id": 5949,
      "surah": 87,
      "ayah": 1,
      "arabic_text": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى",
      "translation": "Xurmo weynee oo ku tasbiixso Magaca Rabbigaa ee Sarreeya.",
      "footnotes": ""
    },
    {
      "id": 5950,
      "surah": 87,
      "ayah": 2,
      "arabic_text": "ٱلَّذِي خَلَقَ فَسَوَّىٰ",
      "translation": "Ee abuuray (uunka) oo ekeeyey.",
      "footnotes": ""
    },
    {
      "id": 5951,
      "surah": 87,
      "ayah": 3,
      "arabic_text": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ",
      "translation": "Ee ah Kan wax walba qaddaray, ee hagay.",
      "footnotes": ""
    },
    {
      "id": 5952,
      "surah": 87,
      "ayah": 4,
      "arabic_text": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ",
      "translation": "Ee ah Kan soo saara daaqa.",
      "footnotes": ""
    },
    {
      "id": 5953,
      "surah": 87,
      "ayah": 5,
      "arabic_text": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ",
      "translation": "Ka dhiga markaas kaddib caws\nengagan oo madow.",
      "footnotes": ""
    },
    {
      "id": 5954,
      "surah": 87,
      "ayah": 6,
      "arabic_text": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ",
      "translation": "Waxaan kuu akhriyeynaa (Nabiyow) Qur’aanka mana illaaweysid,",
      "footnotes": ""
    },
    {
      "id": 5955,
      "surah": 87,
      "ayah": 7,
      "arabic_text": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ",
      "translation": "Wuxuu Alle doono ma’ahee, Wuxuu xaqiiq Og yahay waxa muuqda iyo waxa qarsoonba.",
      "footnotes": ""
    },
    {
      "id": 5956,
      "surah": 87,
      "ayah": 8,
      "arabic_text": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ",
      "translation": "Waxaanu kuu fududeyn waddada sahlan (Islaamka).",
      "footnotes": ""
    },
    {
      "id": 5957,
      "surah": 87,
      "ayah": 9,
      "arabic_text": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ",
      "translation": "Ee waani, markay wax tari waanadu.",
      "footnotes": ""
    },
    {
      "id": 5958,
      "surah": 87,
      "ayah": 10,
      "arabic_text": "سَيَذَّكَّرُ مَن يَخۡشَىٰ",
      "translation": "Waxaa waantoobi Kan (ka) baqa (Alle).",
      "footnotes": ""
    },
    {
      "id": 5959,
      "surah": 87,
      "ayah": 11,
      "arabic_text": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى",
      "translation": "Waxaana ka fogaan 'waanada' qofka xun.",
      "footnotes": ""
    },
    {
      "id": 5960,
      "surah": 87,
      "ayah": 12,
      "arabic_text": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ",
      "translation": "Kaasoo geli Naar weyn oo ku guban.",
      "footnotes": ""
    },
    {
      "id": 5961,
      "surah": 87,
      "ayah": 13,
      "arabic_text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ",
      "translation": "Uusan ku dhimanayn dhexdeeda, kuna noolaanayn.",
      "footnotes": ""
    },
    {
      "id": 5962,
      "surah": 87,
      "ayah": 14,
      "arabic_text": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ",
      "translation": "Waxaa liibaani qofkii ka daahiriya naftiisa (shirkiga iyo macaasida).",
      "footnotes": ""
    },
    {
      "id": 5963,
      "surah": 87,
      "ayah": 15,
      "arabic_text": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ",
      "translation": "Oo xusa Magaca Rabbigi oo tukada.",
      "footnotes": ""
    },
    {
      "id": 5964,
      "surah": 87,
      "ayah": 16,
      "arabic_text": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",
      "translation": "Waxaadse door biddaan nolosha adduunkan;",
      "footnotes": ""
    },
    {
      "id": 5965,
      "surah": 87,
      "ayah": 17,
      "arabic_text": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ",
      "translation": "Aakhiro baase khayr badan oo baaqi ah.",
      "footnotes": ""
    },
    {
      "id": 5966,
      "surah": 87,
      "ayah": 18,
      "arabic_text": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ",
      "translation": "Hubaal (hadal)kani wuxuu ku yaal Kututbtii hore,",
      "footnotes": ""
    },
    {
      "id": 5967,
      "surah": 87,
      "ayah": 19,
      "arabic_text": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ",
      "translation": "Kutubtii Ibraahiim iyo Muuse.",
      "footnotes": ""
    }
  ]
}