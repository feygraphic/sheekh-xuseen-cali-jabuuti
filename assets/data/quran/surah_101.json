{
  "surah_number": 101,
  "ayahs_count": 11,
  "ayahs": [
    {
      "id": 6158,
      "surah": 101,
      "ayah": 1,
      "arabic_text": "ٱلۡقَارِعَةُ",
      "translation": "Garaacdada (qalbiyada waa Qiyaamada).",
      "footnotes": ""
    },
    {
      "id": 6159,
      "surah": 101,
      "ayah": 2,
      "arabic_text": "مَا ٱلۡقَارِعَةُ",
      "translation": "Maxay tahay Garaacdadu?.",
      "footnotes": ""
    },
    {
      "id": 6160,
      "surah": 101,
      "ayah": 3,
      "arabic_text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ",
      "translation": "Maxaa ku ogeysiiyeyna waxay tahay Garaacdadu?",
      "footnotes": ""
    },
    {
      "id": 6161,
      "surah": 101,
      "ayah": 4,
      "arabic_text": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ",
      "translation": "Waa Maalintay dadku noqon sida baalallay kala firdhay.",
      "footnotes": ""
    },
    {
      "id": 6162,
      "surah": 101,
      "ayah": 5,
      "arabic_text": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ",
      "translation": "Oo buurahu noqon sida cudbi la dhilay.",
      "footnotes": ""
    },
    {
      "id": 6163,
      "surah": 101,
      "ayah": 6,
      "arabic_text": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ",
      "translation": "Qofka miisaankiisa (camallada wanaagsan) uu culeys yahay.",
      "footnotes": ""
    },
    {
      "id": 6164,
      "surah": 101,
      "ayah": 7,
      "arabic_text": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ",
      "translation": "Wuxuu ku noolaan nolol barwaaqo iyo farxad leh oo raalli lagu yahay (Janno).",
      "footnotes": ""
    },
    {
      "id": 6165,
      "surah": 101,
      "ayah": 8,
      "arabic_text": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ",
      "translation": "Qofkase uu miisaankiisa (camallada wanaagsan) fudeyd yahay.",
      "footnotes": ""
    },
    {
      "id": 6166,
      "surah": 101,
      "ayah": 9,
      "arabic_text": "فَأُمُّهُۥ هَاوِيَةٞ",
      "translation": "Hoygiisu waa Haawiya.",
      "footnotes": ""
    },
    {
      "id": 6167,
      "surah": 101,
      "ayah": 10,
      "arabic_text": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ",
      "translation": "Maxaa ku ogeysiiyeyna waxay tahay?",
      "footnotes": ""
    },
    {
      "id": 6168,
      "surah": 101,
      "ayah": 11,
      "arabic_text": "نَارٌ حَامِيَةُۢ",
      "translation": "(Waa) Naar kuleyl badan.",
      "footnotes": ""
    }
  ]
}