  "ayahs": [
    {
      "id": 6231,
      "surah": 114,
      "ayah": 1,
      "arabic_text": "قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "translation": "Dheh: Waxaan ka magan galayaa Rabbiga dadka.",
      "footnotes": ""
    },
    {
      "id": 6232,
      "surah": 114,
      "ayah": 2,
      "arabic_text": "مَلِكِ ٱلنَّاسِ",
      "translation": "Boqorka dadka.",
      "footnotes": ""
    },
    {
      "id": 6233,
      "surah": 114,
      "ayah": 3,
      "arabic_text": "إِلَٰهِ ٱلنَّاسِ",
      "translation": "Ilaaha dadka.",
      "footnotes": ""
    },
    {
      "id": 6234,
      "surah": 114,
      "ayah": 4,
      "arabic_text": "مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ",
      "translation": "Sharka waswaasiyaha (sheydaanka) soo noqnoqodka badan.",
      "footnotes": ""
    },
    {
      "id": 6235,
      "surah": 114,
      "ayah": 5,
      "arabic_text": "ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ",
      "translation": "Kaasoo waswaasiya laabaha dadka.",
      "footnotes": ""
    },
    {
      "id": 6236,
      "surah": 114,
      "ayah": 6,
      "arabic_text": "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ",
      "translation": "(Shaydaankaa) oo jin iyo dadba leh.",
      "footnotes": ""
    }
  ]
}