{
  "surah_number": 102,
  "ayahs_count": 8,
  "ayahs": [
    {
      "id": 6169,
      "surah": 102,
      "ayah": 1,
      "arabic_text": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",
      "translation": "Waxaa idin shuqliya (dadow) adduun badsi (iyo isu faan).",
      "footnotes": ""
    },
    {
      "id": 6170,
      "surah": 102,
      "ayah": 2,
      "arabic_text": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",
      "translation": "Ilaa aad siyaarataan qubuuraha (macnaha dhimataan oo la idinku aaso).",
      "footnotes": ""
    },
    {
      "id": 6171,
      "surah": 102,
      "ayah": 3,
      "arabic_text": "كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "translation": "Mayee! Waad ogaan doontaan.",
      "footnotes": ""
    },
    {
      "id": 6172,
      "surah": 102,
      "ayah": 4,
      "arabic_text": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "translation": "Misna, mayee! Waad ogaan doontaan.",
      "footnotes": ""
    },
    {
      "id": 6173,
      "surah": 102,
      "ayah": 5,
      "arabic_text": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ",
      "translation": "Mayee! haddaad og tihiin ogaansho dhab ah.",
      "footnotes": ""
    },
    {
      "id": 6174,
      "surah": 102,
      "ayah": 6,
      "arabic_text": "لَتَرَوُنَّ ٱلۡجَحِيمَ",
      "translation": "Waxaad hubaal arki Naarta ololka badan.",
      "footnotes": ""
    },
    {
      "id": 6175,
      "surah": 102,
      "ayah": 7,
      "arabic_text": "ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ",
      "translation": "Markaas waxaad u ark si yaqiin leh.",
      "footnotes": ""
    },
    {
      "id": 6176,
      "surah": 102,
      "ayah": 8,
      "arabic_text": "ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "translation": "Waxaana Maalintaa la idin weydiin Nicmooyinkii (Alle idinku galladeystay).",
      "footnotes": ""
    }
  ]
}