{
  "surah_number": 92,
  "ayahs_count": 21,
  "ayahs": [
    {
      "id": 6059,
      "surah": 92,
      "ayah": 1,
      "arabic_text": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ",
      "translation": "Waxaan ku dhaartay habeenka markuu daboolo (waxa samada iyo arlada dhexdooda ah).",
      "footnotes": ""
    },
    {
      "id": 6060,
      "surah": 92,
      "ayah": 2,
      "arabic_text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "translation": "Iyo maalinta markay muuqato (ifto);",
      "footnotes": ""
    },
    {
      "id": 6061,
      "surah": 92,
      "ayah": 3,
      "arabic_text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",
      "translation": "Iyo abuurista labka iyo dheddigga.",
      "footnotes": ""
    },
    {
      "id": 6062,
      "surah": 92,
      "ayah": 4,
      "arabic_text": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ",
      "translation": "Xaqiiq, camalkiinnu (dadow) waa kala duwan yahay.",
      "footnotes": ""
    },
    {
      "id": 6063,
      "surah": 92,
      "ayah": 5,
      "arabic_text": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ",
      "translation": "Ma kan bixiya (xuquuqda lagu leeyahay) oo iska jira (shirki iyo macaasi).",
      "footnotes": ""
    },
    {
      "id": 6064,
      "surah": 92,
      "ayah": 6,
      "arabic_text": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ",
      "translation": "Ee rumeeya tan wanaagga badan ee fiican (Jannada):",
      "footnotes": ""
    },
    {
      "id": 6065,
      "surah": 92,
      "ayah": 7,
      "arabic_text": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ",
      "translation": "Waxaan u fududeyneynaa jidka fudud (Islaamka).",
      "footnotes": ""
    },
    {
      "id": 6066,
      "surah": 92,
      "ayah": 8,
      "arabic_text": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ",
      "translation": "Qofkiise ku bakheyla (maalka) oo isu arka mid deeqtoon (iskibriya).",
      "footnotes": ""
    },
    {
      "id": 6067,
      "surah": 92,
      "ayah": 9,
      "arabic_text": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ",
      "translation": "Oo beeniya tan wanaagga badan ee fiican (Jannada).",
      "footnotes": ""
    },
    {
      "id": 6068,
      "surah": 92,
      "ayah": 10,
      "arabic_text": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ",
      "translation": "Waxaan u fududeyneynaa jidka xun (dhabbaha Naarta);",
      "footnotes": ""
    },
    {
      "id": 6069,
      "surah": 92,
      "ayah": 11,
      "arabic_text": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "translation": "Maalkiisu wax uma taro markuu halaagsamo.",
      "footnotes": ""
    },
    {
      "id": 6070,
      "surah": 92,
      "ayah": 12,
      "arabic_text": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ",
      "translation": "Annagaa xaqiiq wax hanuuninna,",
      "footnotes": ""
    },
    {
      "id": 6071,
      "surah": 92,
      "ayah": 13,
      "arabic_text": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ",
      "translation": "Oo Annagaa xaqiiq leh Aakhiro iyo adduunba.",
      "footnotes": ""
    },
    {
      "id": 6072,
      "surah": 92,
      "ayah": 14,
      "arabic_text": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ",
      "translation": "Waxaan idiinka digayaa Naar ololeysa.",
      "footnotes": ""
    },
    {
      "id": 6073,
      "surah": 92,
      "ayah": 15,
      "arabic_text": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى",
      "translation": "Uusan galaynin qof xun mooyaane.",
      "footnotes": ""
    },
    {
      "id": 6074,
      "surah": 92,
      "ayah": 16,
      "arabic_text": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ",
      "translation": "Ee (Xaqa) beeniya oo ka jeesada.",
      "footnotes": ""
    },
    {
      "id": 6075,
      "surah": 92,
      "ayah": 17,
      "arabic_text": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى",
      "translation": "Waxaana laga fogeyn (Naarta) kan (ka) dhowrsada (shirkiga iyo xumaha kale).",
      "footnotes": ""
    },
    {
      "id": 6076,
      "surah": 92,
      "ayah": 18,
      "arabic_text": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ",
      "translation": "Ee bixiya maalkiisa si uu isu daahiriyo.",
      "footnotes": ""
    },
    {
      "id": 6077,
      "surah": 92,
      "ayah": 19,
      "arabic_text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ",
      "translation": "Isagoo uusan jirin cid ku leh abaal uu u gudayo.",
      "footnotes": ""
    },
    {
      "id": 6078,
      "surah": 92,
      "ayah": 20,
      "arabic_text": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ",
      "translation": "Waxse u bixiya doonista Wejiga Rabbigi, ee Sarreeya.",
      "footnotes": ""
    },
    {
      "id": 6079,
      "surah": 92,
      "ayah": 21,
      "arabic_text": "وَلَسَوۡفَ يَرۡضَىٰ",
      "translation": "Wuu raalli noqon doonaa qofkaasi.",
      "footnotes": ""
    }
  ]
}