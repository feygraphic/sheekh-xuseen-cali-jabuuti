{
  "surah_number": 82,
  "ayahs_count": 19,
  "ayahs": [
    {
      "id": 5830,
      "surah": 82,
      "ayah": 1,
      "arabic_text": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ",
      "translation": "Markay samada dildillaacdo.",
      "footnotes": ""
    },
    {
      "id": 5831,
      "surah": 82,
      "ayah": 2,
      "arabic_text": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ",
      "translation": "Markay xiddiguhu daataan oo kala firdhaan.",
      "footnotes": ""
    },
    {
      "id": 5832,
      "surah": 82,
      "ayah": 3,
      "arabic_text": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ",
      "translation": "Marka badaha laysku furo oo soo fatahaan.",
      "footnotes": ""
    },
    {
      "id": 5833,
      "surah": 82,
      "ayah": 4,
      "arabic_text": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ",
      "translation": "Marka qabuuraha la soo qufo.",
      "footnotes": ""
    },
    {
      "id": 5834,
      "surah": 82,
      "ayah": 5,
      "arabic_text": "عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ",
      "translation": "Naf walbaa waxay ogaan waxay hormarsatay iyo (waxay) dib marisay (khayr ama shar oo laga jaazeyn).",
      "footnotes": ""
    },
    {
      "id": 5835,
      "surah": 82,
      "ayah": 6,
      "arabic_text": "يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ",
      "translation": "Qof yahow! Maxaa kaa jeediyey Rabbigaaga, Roonaanta Badan?",
      "footnotes": ""
    },
    {
      "id": 5836,
      "surah": 82,
      "ayah": 7,
      "arabic_text": "ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
      "translation": "Kaasoo ku abuuray, kuna ekeeyey oo ku simay?",
      "footnotes": ""
    },
    {
      "id": 5837,
      "surah": 82,
      "ayah": 8,
      "arabic_text": "فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ",
      "translation": "Suuradduu doonana kuu sameeyey?.",
      "footnotes": ""
    },
    {
      "id": 5838,
      "surah": 82,
      "ayah": 9,
      "arabic_text": "كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ",
      "translation": "Mayee bal waxaad beenisaan maalinta is abaal marinta (jaazeynta).",
      "footnotes": ""
    },
    {
      "id": 5839,
      "surah": 82,
      "ayah": 10,
      "arabic_text": "وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ",
      "translation": "Waxaana xaqiiq korkiinna ah (oo idiin xil saaran malaa’ig) gaar idinka haya.",
      "footnotes": ""
    },
    {
      "id": 5840,
      "surah": 82,
      "ayah": 11,
      "arabic_text": "كِرَامٗا كَٰتِبِينَ",
      "translation": "Sharaf leh, qoraya (acmaashiinna),",
      "footnotes": ""
    },
    {
      "id": 5841,
      "surah": 82,
      "ayah": 12,
      "arabic_text": "يَعۡلَمُونَ مَا تَفۡعَلُونَ",
      "translation": "Ogsoon wax kastoo aad fashaan.",
      "footnotes": ""
    },
    {
      "id": 5842,
      "surah": 82,
      "ayah": 13,
      "arabic_text": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ",
      "translation": "Hubaal, baarriyadu waxay dhex ahaan barwaaqo (Janno).",
      "footnotes": ""
    },
    {
      "id": 5843,
      "surah": 82,
      "ayah": 14,
      "arabic_text": "وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ",
      "translation": "Oo hubaal xume falayaashu waxay ku sugnaan Naar ololaysa.",
      "footnotes": ""
    },
    {
      "id": 5844,
      "surah": 82,
      "ayah": 15,
      "arabic_text": "يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ",
      "translation": "Ay geli oo ku guban Maalinta Is abaalmarinta (Jaazeynta).",
      "footnotes": ""
    },
    {
      "id": 5845,
      "surah": 82,
      "ayah": 16,
      "arabic_text": "وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ",
      "translation": "Kamana maqnaadaan marnaba xaggeeda (Naarta).",
      "footnotes": ""
    },
    {
      "id": 5846,
      "surah": 82,
      "ayah": 17,
      "arabic_text": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
      "translation": "Maxaa ku ogeysiiyey waxay Maalinta is abaal marintu tahay?",
      "footnotes": ""
    },
    {
      "id": 5847,
      "surah": 82,
      "ayah": 18,
      "arabic_text": "ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
      "translation": "Misna, maxaa ku ogeysiiyey waxay Maalinta is abaal marintu tahay?",
      "footnotes": ""
    },
    {
      "id": 5848,
      "surah": 82,
      "ayah": 19,
      "arabic_text": "يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ",
      "translation": "(Waa) maalinta aysan nafi wax u tarin naf kale. Amarkana Maalintaas waxaa gebi ahaanba iska leh Allaah.",
      "footnotes": ""
    }
  ]
}