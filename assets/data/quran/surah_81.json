{
  "surah_number": 81,
  "ayahs_count": 29,
  "ayahs": [
    {
      "id": 5801,
      "surah": 81,
      "ayah": 1,
      "arabic_text": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ",
      "translation": "Marka qorraxda la duubo (oo la iftiin tiro),",
      "footnotes": ""
    },
    {
      "id": 5802,
      "surah": 81,
      "ayah": 2,
      "arabic_text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ",
      "translation": "Oo xiddiguhu daataan (oo nuurkoodu tago),",
      "footnotes": ""
    },
    {
      "id": 5803,
      "surah": 81,
      "ayah": 3,
      "arabic_text": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ",
      "translation": "Oo buuraha la rujiyo 'oo budo noqdaan'.",
      "footnotes": ""
    },
    {
      "id": 5804,
      "surah": 81,
      "ayah": 4,
      "arabic_text": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ",
      "translation": "Oo geela rimman [1] la cidleeyo (oo laga hayaamo).",
      "footnotes": "[1] Qofka waxa uu maal ugu jecel yahay."
    },
    {
      "id": 5805,
      "surah": 81,
      "ayah": 5,
      "arabic_text": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ",
      "translation": "Oo dugaagga la soo wada kulmiyo (qisaas darteed).",
      "footnotes": ""
    },
    {
      "id": 5806,
      "surah": 81,
      "ayah": 6,
      "arabic_text": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ",
      "translation": "Oo badaha la shido (ama isku soo fatahmaan);",
      "footnotes": ""
    },
    {
      "id": 5807,
      "surah": 81,
      "ayah": 7,
      "arabic_text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ",
      "translation": "Oo nafaha lagu lammaaniyo jirarkoodii [1];",
      "footnotes": "[1] Macno kale lagu lammaansho eynigood iyo waxay is leeyihiin oo la mid ah."
    },
    {
      "id": 5808,
      "surah": 81,
      "ayah": 8,
      "arabic_text": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ",
      "translation": "Oo (tii kastoo yaraan) lagu nolol xabaalay la weydiiyo,",
      "footnotes": ""
    },
    {
      "id": 5809,
      "surah": 81,
      "ayah": 9,
      "arabic_text": "بِأَيِّ ذَنۢبٖ قُتِلَتۡ",
      "translation": "Maxaa denbi ahoo loo dilay?",
      "footnotes": ""
    },
    {
      "id": 5810,
      "surah": 81,
      "ayah": 10,
      "arabic_text": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ",
      "translation": "Marka kutubta (acmaasha aadmiga ee malaa'igtu qorayeen) la fidiyo.",
      "footnotes": ""
    },
    {
      "id": 5811,
      "surah": 81,
      "ayah": 11,
      "arabic_text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ",
      "translation": "Oo samada laga rujiyo meesheeda,",
      "footnotes": ""
    },
    {
      "id": 5812,
      "surah": 81,
      "ayah": 12,
      "arabic_text": "وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ",
      "translation": "Oo Naarta la huriyo.",
      "footnotes": ""
    },
    {
      "id": 5813,
      "surah": 81,
      "ayah": 13,
      "arabic_text": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ",
      "translation": "Oo Jannada la soo dhoweeyo.",
      "footnotes": ""
    },
    {
      "id": 5814,
      "surah": 81,
      "ayah": 14,
      "arabic_text": "عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ",
      "translation": "Waxay ogaan nafi waxay la timid (khayr ama shar).",
      "footnotes": ""
    },
    {
      "id": 5815,
      "surah": 81,
      "ayah": 15,
      "arabic_text": "فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ",
      "translation": "Waxaan ku dhaartay xiddigaha qarsooma (maalintii).",
      "footnotes": ""
    },
    {
      "id": 5816,
      "surah": 81,
      "ayah": 16,
      "arabic_text": "ٱلۡجَوَارِ ٱلۡكُنَّسِ",
      "translation": "Ee ku socda rugahooda ee qarsoomee (dhaca).",
      "footnotes": ""
    },
    {
      "id": 5817,
      "surah": 81,
      "ayah": 17,
      "arabic_text": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ",
      "translation": "Iyo habeenka markuu yimaado (ama tago).",
      "footnotes": ""
    },
    {
      "id": 5818,
      "surah": 81,
      "ayah": 18,
      "arabic_text": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ",
      "translation": "Iyo subaxu markuu neefsado (oo soo baxo iftiinkiisa).",
      "footnotes": ""
    },
    {
      "id": 5819,
      "surah": 81,
      "ayah": 19,
      "arabic_text": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ",
      "translation": "Hubaal kani (Qur'aanka) waa hadal 'Alle' uu keenay Rasuul sharaf badan (Jabriil).",
      "footnotes": ""
    },
    {
      "id": 5820,
      "surah": 81,
      "ayah": 20,
      "arabic_text": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ",
      "translation": "Awood iyo meeqaan sare ku leh (Alle) agtiis, Rabbiga Carshiga Weyn,",
      "footnotes": ""
    },
    {
      "id": 5821,
      "surah": 81,
      "ayah": 21,
      "arabic_text": "مُّطَاعٖ ثَمَّ أَمِينٖ",
      "translation": "La adeeco, haddana aamin ah kalsooni lagu qabo.",
      "footnotes": ""
    },
    {
      "id": 5822,
      "surah": 81,
      "ayah": 22,
      "arabic_text": "وَمَا صَاحِبُكُم بِمَجۡنُونٖ",
      "translation": "Saaxiibkiin (Nabi Muxammad) ma aha jinnoole.",
      "footnotes": ""
    },
    {
      "id": 5823,
      "surah": 81,
      "ayah": 23,
      "arabic_text": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ",
      "translation": "Horay buuna ugu arkay (Jabriil) jihada cad (dhinaca qorrax soo baxa).",
      "footnotes": ""
    },
    {
      "id": 5824,
      "surah": 81,
      "ayah": 24,
      "arabic_text": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ",
      "translation": "Ma aha (Nabi Muxammad) mid ceshada 'bakheyla amaba looga shakiyo' cilmiga ku saabsan Ghaybka 'ee Qarsoon'.",
      "footnotes": ""
    },
    {
      "id": 5825,
      "surah": 81,
      "ayah": 25,
      "arabic_text": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ",
      "translation": "(Qur’aankuna) ma aha hadalka Shaydaan laga fogeeyey (Naxariista Alle).",
      "footnotes": ""
    },
    {
      "id": 5826,
      "surah": 81,
      "ayah": 26,
      "arabic_text": "فَأَيۡنَ تَذۡهَبُونَ",
      "translation": "Ee xaggee 'gaalooy' aadeysaan?",
      "footnotes": ""
    },
    {
      "id": 5827,
      "surah": 81,
      "ayah": 27,
      "arabic_text": "إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ",
      "translation": "(Qur’aanku) ma aha waxaan aheyn Waano ku socota ummadaha oo dhan.",
      "footnotes": ""
    },
    {
      "id": 5828,
      "surah": 81,
      "ayah": 28,
      "arabic_text": "لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ",
      "translation": "Qofkii idinka mid ah ee dooni inuu (ku) toosnaado (Xaqa).",
      "footnotes": ""
    },
    {
      "id": 5829,
      "surah": 81,
      "ayah": 29,
      "arabic_text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",
      "translation": "Oo waxna ma dooni kartaan wuxuu Alle doono maahee, Rabbiga uumanka.",
      "footnotes": ""
    }
  ]
}