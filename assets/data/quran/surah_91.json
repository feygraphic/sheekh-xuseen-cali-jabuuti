{
  "surah_number": 91,
  "ayahs_count": 15,
  "ayahs": [
    {
      "id": 6044,
      "surah": 91,
      "ayah": 1,
      "arabic_text": "وَٱلشَّمۡسِ وَضُحَىٰهَا",
      "translation": "Waxaan ku dhaartay qorraxda iyo caddaanta barqadeeda;",
      "footnotes": ""
    },
    {
      "id": 6045,
      "surah": 91,
      "ayah": 2,
      "arabic_text": "وَٱلۡقَمَرِ إِذَا تَلَىٰهَا",
      "translation": "Iyo dayaxa markuu raaco (qorraxda).",
      "footnotes": ""
    },
    {
      "id": 6046,
      "surah": 91,
      "ayah": 3,
      "arabic_text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "translation": "Iyo maalinta markay muujiso (arlada) oo ifiso.",
      "footnotes": ""
    },
    {
      "id": 6047,
      "surah": 91,
      "ayah": 4,
      "arabic_text": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا",
      "translation": "Iyo habeenka markuu daboolo arlada (oo madoobaado).",
      "footnotes": ""
    },
    {
      "id": 6048,
      "surah": 91,
      "ayah": 5,
      "arabic_text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "translation": "Iyo samada iyo siduu (Alle) u dhisay;",
      "footnotes": ""
    },
    {
      "id": 6049,
      "surah": 91,
      "ayah": 6,
      "arabic_text": "وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا",
      "translation": "Iyo arlada iyo siduu (Alle) u fidshay,",
      "footnotes": ""
    },
    {
      "id": 6050,
      "surah": 91,
      "ayah": 7,
      "arabic_text": "وَنَفۡسٖ وَمَا سَوَّىٰهَا",
      "translation": "Iyo nafta iyo siduu (Alle) u ekeeyey.",
      "footnotes": ""
    },
    {
      "id": 6051,
      "surah": 91,
      "ayah": 8,
      "arabic_text": "فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا",
      "translation": "Markaas kala garansiiyey xumaheeda iyo toosnideeda,",
      "footnotes": ""
    },
    {
      "id": 6052,
      "surah": 91,
      "ayah": 9,
      "arabic_text": "قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا",
      "translation": "Waxaa liibaani qofka (ka) daahiriya naftiisa (shirki iyo macaasi).",
      "footnotes": ""
    },
    {
      "id": 6053,
      "surah": 91,
      "ayah": 10,
      "arabic_text": "وَقَدۡ خَابَ مَن دَسَّىٰهَا",
      "translation": "Waxaa khasaari qofka xumeeya naftiisa.",
      "footnotes": ""
    },
    {
      "id": 6054,
      "surah": 91,
      "ayah": 11,
      "arabic_text": "كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ",
      "translation": "Thamuud waxay beeniyeen (Xaqa) kibirkoodii darti.",
      "footnotes": ""
    },
    {
      "id": 6055,
      "surah": 91,
      "ayah": 12,
      "arabic_text": "إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا",
      "translation": "Markuu soo baxay koodii uga sharka badnaa (si uu hasha u dilo).",
      "footnotes": ""
    },
    {
      "id": 6056,
      "surah": 91,
      "ayah": 13,
      "arabic_text": "فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا",
      "translation": "Markaasuu Rasuulkii Alle (Nabi Saalix) ku yidhi : Iska daaya Hasha Alle (ha dilana) oo siiya waraabkeeda.",
      "footnotes": ""
    },
    {
      "id": 6057,
      "surah": 91,
      "ayah": 14,
      "arabic_text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا",
      "translation": "Wayse beeniyeen oo boqna gooyeen hashii (dileen). Markaasuu Rabbigood u baabbi’yey denbigoodii dartiis, oo dhulka la simay (ama ka wada simay ciqaabkii).",
      "footnotes": ""
    },
    {
      "id": 6058,
      "surah": 91,
      "ayah": 15,
      "arabic_text": "وَلَا يَخَافُ عُقۡبَٰهَا",
      "translation": "Kama uuna cabsado cidhibteeda [1].",
      "footnotes": "[1] Cidhibta kuwa uu halaagay oo wax loo soo raacdo ama looga daba yimaado, waayo waa Adkaadaha aan laga adkaan."
    }
  ]
}