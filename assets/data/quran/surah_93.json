{
  "surah_number": 93,
  "ayahs_count": 11,
  "ayahs": [
    {
      "id": 6080,
      "surah": 93,
      "ayah": 1,
      "arabic_text": "وَٱلضُّحَىٰ",
      "translation": "Waxaan ku dhaartay Barqada.",
      "footnotes": ""
    },
    {
      "id": 6081,
      "surah": 93,
      "ayah": 2,
      "arabic_text": "وَٱلَّيۡلِ إِذَا سَجَىٰ",
      "translation": "Iyo habeenka markuu xasilo (madoobaado).",
      "footnotes": ""
    },
    {
      "id": 6082,
      "surah": 93,
      "ayah": 3,
      "arabic_text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "translation": "Rabbigaa kaama tagin (Nabi Muxammadow), mana uu kuu cadhoon.",
      "footnotes": ""
    },
    {
      "id": 6083,
      "surah": 93,
      "ayah": 4,
      "arabic_text": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ",
      "translation": "Aakhiro baa kaaga khayr badan noloshatan (hore ee adduunka).",
      "footnotes": ""
    },
    {
      "id": 6084,
      "surah": 93,
      "ayah": 5,
      "arabic_text": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ",
      "translation": "Rabbigaa baa ku siin (khayr badan), waadna raalli noqon.",
      "footnotes": ""
    },
    {
      "id": 6085,
      "surah": 93,
      "ayah": 6,
      "arabic_text": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ",
      "translation": "Miyuusan ku helin adigoo agoon ah oo ku hoyaadin?",
      "footnotes": ""
    },
    {
      "id": 6086,
      "surah": 93,
      "ayah": 7,
      "arabic_text": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ",
      "translation": "Oo ku helin adigoo habowsan oo kuma hanuunin?",
      "footnotes": ""
    },
    {
      "id": 6087,
      "surah": 93,
      "ayah": 8,
      "arabic_text": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ",
      "translation": "Oo ku helin adigoo caydh ah oo kuma hodmin?",
      "footnotes": ""
    },
    {
      "id": 6088,
      "surah": 93,
      "ayah": 9,
      "arabic_text": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ",
      "translation": "Ee agoon, ha dhibin.",
      "footnotes": ""
    },
    {
      "id": 6089,
      "surah": 93,
      "ayah": 10,
      "arabic_text": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ",
      "translation": "Kan wax ku weydiistana, ha ku qeylin.",
      "footnotes": ""
    },
    {
      "id": 6090,
      "surah": 93,
      "ayah": 11,
      "arabic_text": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ",
      "translation": "Nicmadda Rabbigaana (Islaamka, Towxiidka, Qur'aanka, Xaqa, sheeg (oo ka mahad celi).",
      "footnotes": ""
    }
  ]
}