{
  "surah_number": 94,
  "ayahs_count": 8,
  "ayahs": [
    {
      "id": 6091,
      "surah": 94,
      "ayah": 1,
      "arabic_text": "أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ",
      "translation": "Miyaanaan kuu waasicinnin (Nabi Muxammadow) laabtaada?",
      "footnotes": ""
    },
    {
      "id": 6092,
      "surah": 94,
      "ayah": 2,
      "arabic_text": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ",
      "translation": "Oo sidaa kaaga dejin culeyskii ku saarnaa [1],",
      "footnotes": "[1] Macnaha waa aan kuu dhaafin oo cafin gefafkaaga kuwii hore iyo kuwa dambeba, ama kaa qaadin culeyskii aad dareemeysey billowgii gaarsiinta iyo fidint diinta."
    },
    {
      "id": 6093,
      "surah": 94,
      "ayah": 3,
      "arabic_text": "ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ",
      "translation": "Kaasoo cusleeyey dhabarkaaga,",
      "footnotes": ""
    },
    {
      "id": 6094,
      "surah": 94,
      "ayah": 4,
      "arabic_text": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ",
      "translation": "Oo aanaan kor yeelin meeqaankaaga?",
      "footnotes": ""
    },
    {
      "id": 6095,
      "surah": 94,
      "ayah": 5,
      "arabic_text": "فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا",
      "translation": "Xaqiiq, dhibka waxaa la socda faraj.",
      "footnotes": ""
    },
    {
      "id": 6096,
      "surah": 94,
      "ayah": 6,
      "arabic_text": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا",
      "translation": "Xaqiiq, waxaa dhibka la socda faraj.",
      "footnotes": ""
    },
    {
      "id": 6097,
      "surah": 94,
      "ayah": 7,
      "arabic_text": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ",
      "translation": "Ee markaad bogto (salaadda) ku dadaal duceysiga (iyo Alle ammaanka iyo Xuskiis).",
      "footnotes": ""
    },
    {
      "id": 6098,
      "surah": 94,
      "ayah": 8,
      "arabic_text": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب",
      "translation": "Xagga Rabbigaa (keliyana) wax ka rajee.",
      "footnotes": ""
    }
  ]
}