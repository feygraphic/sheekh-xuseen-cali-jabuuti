{
  "surah_number": 105,
  "ayahs_count": 5,
  "ayahs": [
    {
      "id": 6189,
      "surah": 105,
      "ayah": 1,
      "arabic_text": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ",
      "translation": "Mawaadan ogaan sida Rabbigaa u galay qoladii maroodiga?",
      "footnotes": ""
    },
    {
      "id": 6190,
      "surah": 105,
      "ayah": 2,
      "arabic_text": "أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ",
      "translation": "Sow kama uu dhigin dhagartoodii wax dhumay (ku dhammaaday jab iyo jah wareer),",
      "footnotes": ""
    },
    {
      "id": 6191,
      "surah": 105,
      "ayah": 3,
      "arabic_text": "وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ",
      "translation": "Oo ku soo dirin shimbiro guutoooyin ah,",
      "footnotes": ""
    },
    {
      "id": 6192,
      "surah": 105,
      "ayah": 4,
      "arabic_text": "تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ",
      "translation": "Ku soo ganeysa dhagaxyo dhoobo la kululeeyey ah,",
      "footnotes": ""
    },
    {
      "id": 6193,
      "surah": 105,
      "ayah": 5,
      "arabic_text": "فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ",
      "translation": "Markaas ka yeelay sidii bal la daaqay?",
      "footnotes": ""
    }
  ]
}