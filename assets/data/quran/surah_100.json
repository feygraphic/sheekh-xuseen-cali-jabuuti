{
  "surah_number": 100,
  "ayahs_count": 11,
  "ayahs": [
    {
      "id": 6147,
      "surah": 100,
      "ayah": 1,
      "arabic_text": "وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا",
      "translation": "Waxaan ku dhaartay ordayaasha dheereeya iyagoo qaylyi (fardaha dagaalka, iwm).",
      "footnotes": ""
    },
    {
      "id": 6148,
      "surah": 100,
      "ayah": 2,
      "arabic_text": "فَٱلۡمُورِيَٰتِ قَدۡحٗا",
      "translation": "Iyo kuwa kiciya dhimbilaha dabka.",
      "footnotes": ""
    },
    {
      "id": 6149,
      "surah": 100,
      "ayah": 3,
      "arabic_text": "فَٱلۡمُغِيرَٰتِ صُبۡحٗا",
      "translation": "Iyo kuwa (cadowga) weerara subaxa horeba,",
      "footnotes": ""
    },
    {
      "id": 6150,
      "surah": 100,
      "ayah": 4,
      "arabic_text": "فَأَثَرۡنَ بِهِۦ نَقۡعٗا",
      "translation": "Ee boodhka kiciya,",
      "footnotes": ""
    },
    {
      "id": 6151,
      "surah": 100,
      "ayah": 5,
      "arabic_text": "فَوَسَطۡنَ بِهِۦ جَمۡعًا",
      "translation": "Ee bartanka u gala kulanka 'cadowga';",
      "footnotes": ""
    },
    {
      "id": 6152,
      "surah": 100,
      "ayah": 6,
      "arabic_text": "إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ",
      "translation": "Hubaal! Aadmigu waa ka abaal dhacaa Rabbigi (Allaah).",
      "footnotes": ""
    },
    {
      "id": 6153,
      "surah": 100,
      "ayah": 7,
      "arabic_text": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ",
      "translation": "Isaga baana taasi ka markhaati ah.",
      "footnotes": ""
    },
    {
      "id": 6154,
      "surah": 100,
      "ayah": 8,
      "arabic_text": "وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ",
      "translation": "Oo hubaal waa ku daran yahay Jaceylka maalka.",
      "footnotes": ""
    },
    {
      "id": 6155,
      "surah": 100,
      "ayah": 9,
      "arabic_text": "۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ",
      "translation": "Ma wuusan ogeyn marka waxa ku jira qabuuraha la soo bixiyo.",
      "footnotes": ""
    },
    {
      "id": 6156,
      "surah": 100,
      "ayah": 10,
      "arabic_text": "وَحُصِّلَ مَا فِي ٱلصُّدُورِ",
      "translation": "Waxa ku jirana laabaha la caddeeyo.",
      "footnotes": ""
    },
    {
      "id": 6157,
      "surah": 100,
      "ayah": 11,
      "arabic_text": "إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ",
      "translation": "Hubaal Rabbigood maalintaas waa u Xog-Ogaal (arrimahooda oo dhan).",
      "footnotes": ""
    }
  ]
}