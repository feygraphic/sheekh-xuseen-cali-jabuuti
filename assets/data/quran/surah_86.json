{
  "surah_number": 86,
  "ayahs_count": 17,
  "ayahs": [
    {
      "id": 5932,
      "surah": 86,
      "ayah": 1,
      "arabic_text": "وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "translation": "Waxaan ku dhaartay samada iyo Xiddigga guura.",
      "footnotes": ""
    },
    {
      "id": 5933,
      "surah": 86,
      "ayah": 2,
      "arabic_text": "وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ",
      "translation": "Maxaa ku ogeysiiyey waxa uu xiddiga guura) yahay?",
      "footnotes": ""
    },
    {
      "id": 5934,
      "surah": 86,
      "ayah": 3,
      "arabic_text": "ٱلنَّجۡمُ ٱلثَّاقِبُ",
      "translation": "Waa xiddiggaa iftiinka badan.",
      "footnotes": ""
    },
    {
      "id": 5935,
      "surah": 86,
      "ayah": 4,
      "arabic_text": "إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ",
      "translation": "Ma jirto naf aanu kor joogin ilaaliye (malag).",
      "footnotes": ""
    },
    {
      "id": 5936,
      "surah": 86,
      "ayah": 5,
      "arabic_text": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ",
      "translation": "Ee ha fiiriyo qofka waxa laga abuuray.",
      "footnotes": ""
    },
    {
      "id": 5937,
      "surah": 86,
      "ayah": 6,
      "arabic_text": "خُلِقَ مِن مَّآءٖ دَافِقٖ",
      "translation": "Waxaa laga abuuray biyo horay u soo booda.",
      "footnotes": ""
    },
    {
      "id": 5938,
      "surah": 86,
      "ayah": 7,
      "arabic_text": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ",
      "translation": "Oo ka yimaada dhabarka iyo feeraha dhexdood,",
      "footnotes": ""
    },
    {
      "id": 5939,
      "surah": 86,
      "ayah": 8,
      "arabic_text": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ",
      "translation": "Hubaal (Alle) wuu Karaa inuu u soo celiyo nolosha (dhimasho kaddib).",
      "footnotes": ""
    },
    {
      "id": 5940,
      "surah": 86,
      "ayah": 9,
      "arabic_text": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ",
      "translation": "Maalinta waxyaalaha qarsoon iyo siraha la soo bandhigi (xaqiiqdooda).",
      "footnotes": ""
    },
    {
      "id": 5941,
      "surah": 86,
      "ayah": 10,
      "arabic_text": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ",
      "translation": "Ma leh (gaalku Maalintaas) xoog ama wax u soo gargaara midna.",
      "footnotes": ""
    },
    {
      "id": 5942,
      "surah": 86,
      "ayah": 11,
      "arabic_text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ",
      "translation": "Waxaan ku dhaartay cirka leh roobka soo noqnoqda.",
      "footnotes": ""
    },
    {
      "id": 5943,
      "surah": 86,
      "ayah": 12,
      "arabic_text": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ",
      "translation": "Iyo dhulka dil-dillaaca badan (ee soo saara dhirta iyo daaqa),",
      "footnotes": ""
    },
    {
      "id": 5944,
      "surah": 86,
      "ayah": 13,
      "arabic_text": "إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ",
      "translation": "Xaqiiq, kani (Qur'aanku) waa hadal cad oo kala saara (xaqa iyo baadilka).",
      "footnotes": ""
    },
    {
      "id": 5945,
      "surah": 86,
      "ayah": 14,
      "arabic_text": "وَمَا هُوَ بِٱلۡهَزۡلِ",
      "translation": "Oo ma aha dhayal (dheel).",
      "footnotes": ""
    },
    {
      "id": 5946,
      "surah": 86,
      "ayah": 15,
      "arabic_text": "إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا",
      "translation": "Xaqiiq (gaaladu) wax bay dhagri oo qorsheyn.",
      "footnotes": ""
    },
    {
      "id": 5947,
      "surah": 86,
      "ayah": 16,
      "arabic_text": "وَأَكِيدُ كَيۡدٗا",
      "translation": "Aniguna (sidoo kale) Waxaan qorsheyn qorshe.",
      "footnotes": ""
    },
    {
      "id": 5948,
      "surah": 86,
      "ayah": 17,
      "arabic_text": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا",
      "translation": "Ee u sug gaalada: Daa wax yar.",
      "footnotes": ""
    }
  ]
}