{
  "surah_number": 104,
  "ayahs_count": 9,
  "ayahs": [
    {
      "id": 6180,
      "surah": 104,
      "ayah": 1,
      "arabic_text": "وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ",
      "translation": "Hoog waxaa leh dure kasta, wax xanta.",
      "footnotes": ""
    },
    {
      "id": 6181,
      "surah": 104,
      "ayah": 2,
      "arabic_text": "ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ",
      "translation": "Kaasoo maal ururiya oo u heysta sahay ahaan (aanse ka bixin xaqa lagu leeyahay: sakada, iwm);",
      "footnotes": ""
    },
    {
      "id": 6182,
      "surah": 104,
      "ayah": 3,
      "arabic_text": "يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ",
      "translation": "Wuxuu moodaa in maalkiisu waarin.",
      "footnotes": ""
    },
    {
      "id": 6183,
      "surah": 104,
      "ayah": 4,
      "arabic_text": "كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ",
      "translation": "Mayee! Waxaa lagu tuuri burburisada.",
      "footnotes": ""
    },
    {
      "id": 6184,
      "surah": 104,
      "ayah": 5,
      "arabic_text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ",
      "translation": "Maxaa ku ogeysiiyeyna waxay burburisadu tahay?",
      "footnotes": ""
    },
    {
      "id": 6185,
      "surah": 104,
      "ayah": 6,
      "arabic_text": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ",
      "translation": "Waa Naar Alle oo la huriyey.",
      "footnotes": ""
    },
    {
      "id": 6186,
      "surah": 104,
      "ayah": 7,
      "arabic_text": "ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ",
      "translation": "Ee kor ugu baxda quluubta dushooda (iyadoo gubeysa),",
      "footnotes": ""
    },
    {
      "id": 6187,
      "surah": 104,
      "ayah": 8,
      "arabic_text": "إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ",
      "translation": "Waxaa lagaga xidhi dusha (gaalada).",
      "footnotes": ""
    },
    {
      "id": 6188,
      "surah": 104,
      "ayah": 9,
      "arabic_text": "فِي عَمَدٖ مُّمَدَّدَةِۭ",
      "translation": "Tiirar la taagay dhexdood.",
      "footnotes": ""
    }
  ]
}