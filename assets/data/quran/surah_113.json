{
  "surah_number": 113,
  "ayahs_count": 5,
  "ayahs": [
    {
      "id": 6226,
      "surah": 113,
      "ayah": 1,
      "arabic_text": "قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ",
      "translation": "Dheh: Waxaan ka magan galayaa Rabbiga oogga (dillaacsha, waa Alle'e),",
      "footnotes": ""
    },
    {
      "id": 6227,
      "surah": 113,
      "ayah": 2,
      "arabic_text": "مِن شَرِّ مَا خَلَقَ",
      "translation": "Sharka wuxuu abuuray;",
      "footnotes": ""
    },
    {
      "id": 6228,
      "surah": 113,
      "ayah": 3,
      "arabic_text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "translation": "Iyo sharka habeenka mugdiga badan markuu mugdigiisa daboolo (samada iyo arlada dhexdooda).",
      "footnotes": ""
    },
    {
      "id": 6229,
      "surah": 113,
      "ayah": 4,
      "arabic_text": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ",
      "translation": "Iyo sharka kuwa wax ku tufa guntimaha (saaxirooyinka iyo sixiroolayaasha).",
      "footnotes": ""
    },
    {
      "id": 6230,
      "surah": 113,
      "ayah": 5,
      "arabic_text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "translation": "Iyo sharka xaasidka markuu wax xasdo.",
      "footnotes": ""
    }
  ]
}