{
  "surah_number": 80,
  "ayahs_count": 42,
  "ayahs": [
    {
      "id": 5759,
      "surah": 80,
      "ayah": 1,
      "arabic_text": "عَبَسَ وَتَوَلَّىٰٓ",
      "translation": "(Wejiguu) kuduuday oo jeesaday (Nebiga s.c.w),",
      "footnotes": ""
    },
    {
      "id": 5760,
      "surah": 80,
      "ayah": 2,
      "arabic_text": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ",
      "translation": "Inuu u yimid indhoolihii [1] darteed,",
      "footnotes": "[1] Waa Cabdullaah ibn Um Maktuum a.k.r."
    },
    {
      "id": 5761,
      "surah": 80,
      "ayah": 3,
      "arabic_text": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "translation": "Miyaadse ogtahay waa intaasoo uu dooni inuu hanuuno oo is daahiriyo,",
      "footnotes": ""
    },
    {
      "id": 5762,
      "surah": 80,
      "ayah": 4,
      "arabic_text": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ",
      "translation": "Ama waansamo, oo waanadu anfacdo.",
      "footnotes": ""
    },
    {
      "id": 5763,
      "surah": 80,
      "ayah": 5,
      "arabic_text": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ",
      "translation": "Kan is deeqtoonsiiya (ee isla weyn),",
      "footnotes": ""
    },
    {
      "id": 5764,
      "surah": 80,
      "ayah": 6,
      "arabic_text": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "translation": "Miyaad adigu u banbixi,",
      "footnotes": ""
    },
    {
      "id": 5765,
      "surah": 80,
      "ayah": 7,
      "arabic_text": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ",
      "translation": "Eedna kaama saarna hadduusan hanuunin oo daahirin naftiisa,",
      "footnotes": ""
    },
    {
      "id": 5766,
      "surah": 80,
      "ayah": 8,
      "arabic_text": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ",
      "translation": "Kan se kuu yimid isagoo dadaalaya,",
      "footnotes": ""
    },
    {
      "id": 5767,
      "surah": 80,
      "ayah": 9,
      "arabic_text": "وَهُوَ يَخۡشَىٰ",
      "translation": "Oo (Alle ka) baqa,",
      "footnotes": ""
    },
    {
      "id": 5768,
      "surah": 80,
      "ayah": 10,
      "arabic_text": "فَأَنتَ عَنۡهُ تَلَهَّىٰ",
      "translation": "Miyaad adigu ka mashquuli.",
      "footnotes": ""
    },
    {
      "id": 5769,
      "surah": 80,
      "ayah": 11,
      "arabic_text": "كَلَّآ إِنَّهَا تَذۡكِرَةٞ",
      "translation": "Mayee, Aayadahani waa waano.",
      "footnotes": ""
    },
    {
      "id": 5770,
      "surah": 80,
      "ayah": 12,
      "arabic_text": "فَمَن شَآءَ ذَكَرَهُۥ",
      "translation": "Ee qofkii doona ha ku waano qaato.",
      "footnotes": ""
    },
    {
      "id": 5771,
      "surah": 80,
      "ayah": 13,
      "arabic_text": "فِي صُحُفٖ مُّكَرَّمَةٖ",
      "translation": "Waxay ku sugan tahay (waanadan) kutub la sharfay (Looxa Maxfuudka).",
      "footnotes": ""
    },
    {
      "id": 5772,
      "surah": 80,
      "ayah": 14,
      "arabic_text": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ",
      "translation": "Kor ah, la dahiray.",
      "footnotes": ""
    },
    {
      "id": 5773,
      "surah": 80,
      "ayah": 15,
      "arabic_text": "بِأَيۡدِي سَفَرَةٖ",
      "translation": "Ku jira gacmaha qorayaal (malaa’ig).",
      "footnotes": ""
    },
    {
      "id": 5774,
      "surah": 80,
      "ayah": 16,
      "arabic_text": "كِرَامِۭ بَرَرَةٖ",
      "translation": "Sharaf leh oo baariyaal ah.",
      "footnotes": ""
    },
    {
      "id": 5775,
      "surah": 80,
      "ayah": 17,
      "arabic_text": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ",
      "translation": "Belo ha ku dhacdo aadmigee (waa kan gaalka ahi)! Muxuu jazaar yahay!",
      "footnotes": ""
    },
    {
      "id": 5776,
      "surah": 80,
      "ayah": 18,
      "arabic_text": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ",
      "translation": "Muxuu Alle ka abuuray?",
      "footnotes": ""
    },
    {
      "id": 5777,
      "surah": 80,
      "ayah": 19,
      "arabic_text": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "translation": "Dhibic mani ah buu ka abuuray wuuna ekeeyey.",
      "footnotes": ""
    },
    {
      "id": 5778,
      "surah": 80,
      "ayah": 20,
      "arabic_text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "translation": "Markaas uga dhigay sahal dhabbaha [1];",
      "footnotes": "[1] Waa ka soo bixitaanka uurka hooyadi ama dhabbaha nolosha Ama jidka hanuunka."
    },
    {
      "id": 5779,
      "surah": 80,
      "ayah": 21,
      "arabic_text": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ",
      "translation": "Markaasuu sababaa inuu dhinto, oo qabri lagu aaso;",
      "footnotes": ""
    },
    {
      "id": 5780,
      "surah": 80,
      "ayah": 22,
      "arabic_text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "translation": "Markuu doonana wuu soo bixin.",
      "footnotes": ""
    },
    {
      "id": 5781,
      "surah": 80,
      "ayah": 23,
      "arabic_text": "كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ",
      "translation": "Mayee, ma uusan yeelin wuxuu amray.",
      "footnotes": ""
    },
    {
      "id": 5782,
      "surah": 80,
      "ayah": 24,
      "arabic_text": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "translation": "Ee qofku bal ha eego cunnadiisa.",
      "footnotes": ""
    },
    {
      "id": 5783,
      "surah": 80,
      "ayah": 25,
      "arabic_text": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا",
      "translation": "Annagaa soo shubna biyaha (roobka) soo shubid badan,",
      "footnotes": ""
    },
    {
      "id": 5784,
      "surah": 80,
      "ayah": 26,
      "arabic_text": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا",
      "translation": "Markaas Waxaan jeexnaa arlada jeexdin.",
      "footnotes": ""
    },
    {
      "id": 5785,
      "surah": 80,
      "ayah": 27,
      "arabic_text": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا",
      "translation": "Oo ka soo bixinnaa hadhuudh,",
      "footnotes": ""
    },
    {
      "id": 5786,
      "surah": 80,
      "ayah": 28,
      "arabic_text": "وَعِنَبٗا وَقَضۡبٗا",
      "translation": "Iyo cinab iyo naq.",
      "footnotes": ""
    },
    {
      "id": 5787,
      "surah": 80,
      "ayah": 29,
      "arabic_text": "وَزَيۡتُونٗا وَنَخۡلٗا",
      "translation": "Iyo zaytuun iyo geedo timireed.",
      "footnotes": ""
    },
    {
      "id": 5788,
      "surah": 80,
      "ayah": 30,
      "arabic_text": "وَحَدَآئِقَ غُلۡبٗا",
      "translation": "Iyo beero tanaad ah.",
      "footnotes": ""
    },
    {
      "id": 5789,
      "surah": 80,
      "ayah": 31,
      "arabic_text": "وَفَٰكِهَةٗ وَأَبّٗا",
      "translation": "Iyo midho iyo caws.",
      "footnotes": ""
    },
    {
      "id": 5790,
      "surah": 80,
      "ayah": 32,
      "arabic_text": "مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",
      "translation": "Sahay aad leedihiin ah idinka iyo xoolihiinnuba.",
      "footnotes": ""
    },
    {
      "id": 5791,
      "surah": 80,
      "ayah": 33,
      "arabic_text": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "translation": "Markase ay qeylada dhego beelisada ah timaaddo (afuufka labaad ee Buunka).",
      "footnotes": ""
    },
    {
      "id": 5792,
      "surah": 80,
      "ayah": 34,
      "arabic_text": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ",
      "translation": "Maalinta uu qofku ka carari walaalki,",
      "footnotes": ""
    },
    {
      "id": 5793,
      "surah": 80,
      "ayah": 35,
      "arabic_text": "وَأُمِّهِۦ وَأَبِيهِ",
      "translation": "Iyo hooyadi iyo aabbihi.",
      "footnotes": ""
    },
    {
      "id": 5794,
      "surah": 80,
      "ayah": 36,
      "arabic_text": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
      "translation": "Iyo xaaskiisa iyo ilmahiisa,",
      "footnotes": ""
    },
    {
      "id": 5795,
      "surah": 80,
      "ayah": 37,
      "arabic_text": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ",
      "translation": "Qof walba oo ka mid ah Maalinkaas waxaa heysan arrin ku filan.",
      "footnotes": ""
    },
    {
      "id": 5796,
      "surah": 80,
      "ayah": 38,
      "arabic_text": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ",
      "translation": "Wejiyo (qaar) Maalinkaas way ifi.",
      "footnotes": ""
    },
    {
      "id": 5797,
      "surah": 80,
      "ayah": 39,
      "arabic_text": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ",
      "translation": "Iyagoo qosli ku faraxsan (Jannada) loogu bishaareyey.",
      "footnotes": ""
    },
    {
      "id": 5798,
      "surah": 80,
      "ayah": 40,
      "arabic_text": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ",
      "translation": "Wejiyona Maalinkaas (Qiyaame) waxay ahaan kuwo booreysan dulli ka muuqdo;",
      "footnotes": ""
    },
    {
      "id": 5799,
      "surah": 80,
      "ayah": 41,
      "arabic_text": "تَرۡهَقُهَا قَتَرَةٌ",
      "translation": "Mugdi baa dabooli (iyo naxdin).",
      "footnotes": ""
    },
    {
      "id": 5800,
      "surah": 80,
      "ayah": 42,
      "arabic_text": "أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ",
      "translation": "Kuwaasi waa kuwa ah gaalada, denbiilayaasha.",
      "footnotes": ""
    }
  ]
}