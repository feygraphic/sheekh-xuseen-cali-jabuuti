{
  "surah_number": 88,
  "ayahs_count": 26,
  "ayahs": [
    {
      "id": 5968,
      "surah": 88,
      "ayah": 1,
      "arabic_text": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ",
      "translation": "Mawuusan kuu iman warka dabooshada (Qiyaamada).",
      "footnotes": ""
    },
    {
      "id": 5969,
      "surah": 88,
      "ayah": 2,
      "arabic_text": "وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ",
      "translation": "Wejiyaal maalintaas waxay ahaan kuwo dullaysan (waa gaalada).",
      "footnotes": ""
    },
    {
      "id": 5970,
      "surah": 88,
      "ayah": 3,
      "arabic_text": "عَامِلَةٞ نَّاصِبَةٞ",
      "translation": "(Ku) howlan (adduunka caabuddaada cid kale la jirka Alle), daallan (Aakhirada).",
      "footnotes": ""
    },
    {
      "id": 5971,
      "surah": 88,
      "ayah": 4,
      "arabic_text": "تَصۡلَىٰ نَارًا حَامِيَةٗ",
      "translation": "Gali Naar kulul oo ku guban.",
      "footnotes": ""
    },
    {
      "id": 5972,
      "surah": 88,
      "ayah": 5,
      "arabic_text": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ",
      "translation": "Waxaa laga waraabin il kulul oo kareysa.",
      "footnotes": ""
    },
    {
      "id": 5973,
      "surah": 88,
      "ayah": 6,
      "arabic_text": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ",
      "translation": "Ma laha wax cunto ah qodxo maahee.",
      "footnotes": ""
    },
    {
      "id": 5974,
      "surah": 88,
      "ayah": 7,
      "arabic_text": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ",
      "translation": "Kaasoo aan waxna cayilineynin, gaajona wax ka tareyn.",
      "footnotes": ""
    },
    {
      "id": 5975,
      "surah": 88,
      "ayah": 8,
      "arabic_text": "وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ",
      "translation": "Wejiyo Maalintaas waxay ahaan kuwo nicmeysan (waa wejiyada mu'miniinta).",
      "footnotes": ""
    },
    {
      "id": 5976,
      "surah": 88,
      "ayah": 9,
      "arabic_text": "لِّسَعۡيِهَا رَاضِيَةٞ",
      "translation": "Raalli ah dadaalkoodii darti.",
      "footnotes": ""
    },
    {
      "id": 5977,
      "surah": 88,
      "ayah": 10,
      "arabic_text": "فِي جَنَّةٍ عَالِيَةٖ",
      "translation": "Ku sugnaan Janno sare gudaheed.",
      "footnotes": ""
    },
    {
      "id": 5978,
      "surah": 88,
      "ayah": 11,
      "arabic_text": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ",
      "translation": "Aysan ku maqleyn hadal macno darro ah.",
      "footnotes": ""
    },
    {
      "id": 5979,
      "surah": 88,
      "ayah": 12,
      "arabic_text": "فِيهَا عَيۡنٞ جَارِيَةٞ",
      "translation": "Waxaa ah dhexdeeda il socota.",
      "footnotes": ""
    },
    {
      "id": 5980,
      "surah": 88,
      "ayah": 13,
      "arabic_text": "فِيهَا سُرُرٞ مَّرۡفُوعَةٞ",
      "translation": "Iyo sariirro la kor yeelay.",
      "footnotes": ""
    },
    {
      "id": 5981,
      "surah": 88,
      "ayah": 14,
      "arabic_text": "وَأَكۡوَابٞ مَّوۡضُوعَةٞ",
      "translation": "Iyo koobab diyaar laga dhigay.",
      "footnotes": ""
    },
    {
      "id": 5982,
      "surah": 88,
      "ayah": 15,
      "arabic_text": "وَنَمَارِقُ مَصۡفُوفَةٞ",
      "translation": "Iyo barkimooyin la safay.",
      "footnotes": ""
    },
    {
      "id": 5983,
      "surah": 88,
      "ayah": 16,
      "arabic_text": "وَزَرَابِيُّ مَبۡثُوثَةٌ",
      "translation": "Iyo gogollo la fidshey.",
      "footnotes": ""
    },
    {
      "id": 5984,
      "surah": 88,
      "ayah": 17,
      "arabic_text": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ",
      "translation": "Mawaysan fiirin geela, sida loo abuuray?",
      "footnotes": ""
    },
    {
      "id": 5985,
      "surah": 88,
      "ayah": 18,
      "arabic_text": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ",
      "translation": "Iyo cirka, sida loo kor yeelay?",
      "footnotes": ""
    },
    {
      "id": 5986,
      "surah": 88,
      "ayah": 19,
      "arabic_text": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ",
      "translation": "Iyo buuraha, sida loo taagay?",
      "footnotes": ""
    },
    {
      "id": 5987,
      "surah": 88,
      "ayah": 20,
      "arabic_text": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ",
      "translation": "Iyo dhulka, sida loo fidiyey?",
      "footnotes": ""
    },
    {
      "id": 5988,
      "surah": 88,
      "ayah": 21,
      "arabic_text": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ",
      "translation": "Ee waani (dadka), waayo waxaad adigu (Nabiyow) uun tahay waaniye.",
      "footnotes": ""
    },
    {
      "id": 5989,
      "surah": 88,
      "ayah": 22,
      "arabic_text": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ",
      "translation": "Ma tihid adigu mid qasab ku leh.",
      "footnotes": ""
    },
    {
      "id": 5990,
      "surah": 88,
      "ayah": 23,
      "arabic_text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "translation": "Qofkiise (Xaqa) ka jeesada oo gaalooba;",
      "footnotes": ""
    },
    {
      "id": 5991,
      "surah": 88,
      "ayah": 24,
      "arabic_text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ",
      "translation": "Wuxuu Alle ku cadaabi cadaab aad u weyn.",
      "footnotes": ""
    },
    {
      "id": 5992,
      "surah": 88,
      "ayah": 25,
      "arabic_text": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ",
      "translation": "Hubaal waa Xaggayaga meel noqodkoodu;",
      "footnotes": ""
    },
    {
      "id": 5993,
      "surah": 88,
      "ayah": 26,
      "arabic_text": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم",
      "translation": "Markaas hubaal Annagay na saaran tahay xisaabintooda.",
      "footnotes": ""
    }
  ]
}