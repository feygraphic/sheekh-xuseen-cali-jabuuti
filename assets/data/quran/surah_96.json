{
  "surah_number": 96,
  "ayahs_count": 19,
  "ayahs": [
    {
      "id": 6107,
      "surah": 96,
      "ayah": 1,
      "arabic_text": "ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ",
      "translation": "Ku akhri 'Nabiyow' Magaca Rabbigaa ee abuuray (wax waliba).",
      "footnotes": ""
    },
    {
      "id": 6108,
      "surah": 96,
      "ayah": 2,
      "arabic_text": "خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ",
      "translation": "Ka abuuray aadmiga xinjir.",
      "footnotes": ""
    },
    {
      "id": 6109,
      "surah": 96,
      "ayah": 3,
      "arabic_text": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ",
      "translation": "Akhri! Rabbigaana waa Sharaf Badnaha,",
      "footnotes": ""
    },
    {
      "id": 6110,
      "surah": 96,
      "ayah": 4,
      "arabic_text": "ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ",
      "translation": "(Dadka) baray sida wax loogu qoro qalinka.",
      "footnotes": ""
    },
    {
      "id": 6111,
      "surah": 96,
      "ayah": 5,
      "arabic_text": "عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ",
      "translation": "Baray Aadmiga wax uusan aqoon.",
      "footnotes": ""
    },
    {
      "id": 6112,
      "surah": 96,
      "ayah": 6,
      "arabic_text": "كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ",
      "translation": "Mayee! Aadmigu (kan gaalka ahi) wuu xadgudbaa oo kibraa.",
      "footnotes": ""
    },
    {
      "id": 6113,
      "surah": 96,
      "ayah": 7,
      "arabic_text": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ",
      "translation": "Markuu isku ogaado Hodantinnimo iyo deeqtoonaan.",
      "footnotes": ""
    },
    {
      "id": 6114,
      "surah": 96,
      "ayah": 8,
      "arabic_text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ",
      "translation": "Hubaal! Waa xagga Rabbigaa noqodku.",
      "footnotes": ""
    },
    {
      "id": 6115,
      "surah": 96,
      "ayah": 9,
      "arabic_text": "أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ",
      "translation": "Ka warran midka ka reeba.",
      "footnotes": ""
    },
    {
      "id": 6116,
      "surah": 96,
      "ayah": 10,
      "arabic_text": "عَبۡدًا إِذَا صَلَّىٰٓ",
      "translation": "Addoon (Alle) oo tukan salaad?",
      "footnotes": ""
    },
    {
      "id": 6117,
      "surah": 96,
      "ayah": 11,
      "arabic_text": "أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ",
      "translation": "Bal ka warran hadduu ku sugan yahay (addoonkaa) jid toosan?",
      "footnotes": ""
    },
    {
      "id": 6118,
      "surah": 96,
      "ayah": 12,
      "arabic_text": "أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ",
      "translation": "Amaba uu amro Alle ka cabsiga iyo xume ka dhowrsiga?",
      "footnotes": ""
    },
    {
      "id": 6119,
      "surah": 96,
      "ayah": 13,
      "arabic_text": "أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "translation": "Bal ka warran hadduu kaasina (gaalka ahi) beeniyo Xaqa, kana jeesado?",
      "footnotes": ""
    },
    {
      "id": 6120,
      "surah": 96,
      "ayah": 14,
      "arabic_text": "أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "translation": "Mawuusan ogeyn in Alle arko?",
      "footnotes": ""
    },
    {
      "id": 6121,
      "surah": 96,
      "ayah": 15,
      "arabic_text": "كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ",
      "translation": "Mayee! Haddii uusan meel joogin, waxaanu hubaal qaban foodda,",
      "footnotes": ""
    },
    {
      "id": 6122,
      "surah": 96,
      "ayah": 16,
      "arabic_text": "نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ",
      "translation": "Food beenley ah oo gefley ah.",
      "footnotes": ""
    },
    {
      "id": 6123,
      "surah": 96,
      "ayah": 17,
      "arabic_text": "فَلۡيَدۡعُ نَادِيَهُۥ",
      "translation": "Ha u yeedho golihiisa.",
      "footnotes": ""
    },
    {
      "id": 6124,
      "surah": 96,
      "ayah": 18,
      "arabic_text": "سَنَدۡعُ ٱلزَّبَانِيَةَ",
      "translation": "Waxaanu u yeedhi malaa’ig daran.",
      "footnotes": ""
    },
    {
      "id": 6125,
      "surah": 96,
      "ayah": 19,
      "arabic_text": "كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩",
      "translation": "Mayee, ha adeecin oo sujuud, una dhowow (Alle).",
      "footnotes": ""
    }
  ]
}